# Keep employee-level HR source data out of public repositories
/data/raw/*
!/data/raw/.gitkeep
/data/interim/
/data/processed/
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
*.log
.ipynb_checkpoints/
/dbt_hr/target/
/dbt_hr/logs/
/dbt_hr/dbt_packages/
/dbt_hr/.user.yml
# Power BI local import cache and credentials/settings (never publish).
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
**/.pbi/unappliedChanges.json
*.pbix
/.phase7_runtime/
/.venv-phase7/
/.phase8_runtime/
