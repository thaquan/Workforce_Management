{
  "name": "WorkforceIntelligence",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Dim Month",
        "columns": [
          {
            "name": "month",
            "dataType": "dateTime",
            "sourceColumn": "month",
            "summarizeBy": "none"
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "summarizeBy": "none"
          },
          {
            "name": "month_number",
            "dataType": "int64",
            "sourceColumn": "month_number",
            "summarizeBy": "none"
          },
          {
            "name": "year_month",
            "dataType": "string",
            "sourceColumn": "year_month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim Month",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5433\", \"workforce_dw\", [Query=\"SELECT DISTINCT month, year, month_number, to_char(month,'YYYY-MM') AS year_month FROM marts.dim_date WHERE month BETWEEN DATE '2023-01-01' AND DATE '2025-12-01' ORDER BY month\"]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"month\", type datetime}, {\"year\", Int64.Type}, {\"month_number\", Int64.Type}, {\"year_month\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
