      {
        "name": "Quality Results",
        "columns": [
          {
            "name": "pipeline_run_id",
            "dataType": "int64",
            "lineageTag": "42e5425a-5529-416b-8b5d-bdf12a064659",
            "sourceColumn": "pipeline_run_id",
            "summarizeBy": "none"
          },
          {
            "name": "check_id",
            "dataType": "string",
            "lineageTag": "c7ce8086-2626-4ad1-af49-5e4cb82bcbfc",
            "sourceColumn": "check_id",
            "summarizeBy": "none"
          },
          {
            "name": "status",
            "dataType": "string",
            "lineageTag": "3aee18c2-0a7d-44c4-96ea-35e888836b14",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "affected_count",
