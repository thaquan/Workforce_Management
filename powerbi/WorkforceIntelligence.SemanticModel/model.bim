              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"127.0.0.1:5433\", \"workforce_dw\", [Query=\"SELECT month, snapshot_headcount, employee_asof_headcount, headcount_difference, reconciliation_status FROM marts.mart_workforce_reconciliation\"]),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"month\", type datetime}, {\"snapshot_headcount\", Int64.Type}, {\"employee_asof_headcount\", Int64.Type}, {\"headcount_difference\", Int64.Type}, {\"reconciliation_status\", type text}})",
