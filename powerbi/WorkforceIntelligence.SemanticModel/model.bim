                "    Source = PostgreSQL.Database(\"127.0.0.1:5433\", \"workforce_dw\", [Query=\"SELECT current_department_id, exited, COUNT(*) AS employee_count, COUNT(last_pre_exit_engagement_score) AS engagement_count, SUM(last_pre_exit_engagement_score) AS engagement_sum, COUNT(last_pre_exit_performance_rating) AS performance_count, SUM(last_pre_exit_performance_rating) AS performance_sum, SUM(absence_days_prior_365) AS absence_days_sum FROM marts.mart_retention_analysis GROUP BY current_department_id, exited\"]),",
