      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Placeholder",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "986ac4dc-340e-42aa-83bd-0c202311b718",
            "sourceColumn": "Placeholder",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "4225c7af-5f2f-4931-85d8-290ae7a46abb",
        "measures": [
          {
            "name": "Ending Headcount",
            "description": "Stock at last selected reporting month; never sum across months.",
            "displayFolder": "01 Workforce",
            "expression": [
              "VAR LastMonth = MAX ( 'Dim Month'[month] )",
              "RETURN CALCULATE ( SUM ( 'Fact Workforce'[headcount] ), KEEPFILTERS ( 'Dim Month'[month] = LastMonth ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "2ac44f6f-bdce-4da1-acde-b9a87c03b650"
          },
          {
            "name": "Ending FTE",
            "description": "Stock at last selected reporting month.",
            "displayFolder": "01 Workforce",
            "expression": [
              "VAR LastMonth = MAX ( 'Dim Month'[month] )",
              "RETURN CALCULATE ( SUM ( 'Fact Workforce'[fte] ), KEEPFILTERS ( 'Dim Month'[month] = LastMonth ) )"
            ],
            "formatString": "#,0.0",
            "lineageTag": "640845c6-927d-412b-843a-2855481f00d9"
          },
          {
            "name": "Weighted Average Tenure Months",
            "description": "Weighted by headcount, excluding unavailable tenure.",
            "displayFolder": "01 Workforce",
            "expression": [
              "VAR M = MAX ( 'Dim Month'[month] )",
              "RETURN CALCULATE (",
              "    DIVIDE ( SUMX ( 'Fact Workforce', 'Fact Workforce'[headcount] * 'Fact Workforce'[avg_tenure_months] ),",
              "             SUMX ( FILTER ( 'Fact Workforce', NOT ISBLANK ( 'Fact Workforce'[avg_tenure_months] ) ), 'Fact Workforce'[headcount] ) ),",
              "    KEEPFILTERS ( 'Dim Month'[month] = M ) )"
            ],
            "formatString": "#,0.0",
            "lineageTag": "9321495a-a0af-4341-bbdb-61d23a07c0e6"
          },
          {
            "name": "Prior Month Headcount",
            "displayFolder": "01 Workforce",
            "expression": [
              "VAR M = EDATE ( MAX ( 'Dim Month'[month] ), -1 )",
              "RETURN CALCULATE ( [Ending Headcount], REMOVEFILTERS ( 'Dim Month' ), 'Dim Month'[month] = M )"
            ],
            "formatString": "#,0",
            "lineageTag": "c6f21797-a24d-431d-ae2e-843451199d60"
          },
          {
            "name": "Headcount MoM Change",
            "displayFolder": "01 Workforce",
            "expression": "IF ( NOT ISBLANK ( [Prior Month Headcount] ), [Ending Headcount] - [Prior Month Headcount] )",
            "formatString": "#,0",
            "lineageTag": "bc86261a-4856-4ddd-a4d4-9c442b3e49fd"
          },
          {
            "name": "Headcount MoM %",
            "displayFolder": "01 Workforce",
            "expression": "DIVIDE ( [Headcount MoM Change], [Prior Month Headcount] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "d23a3d05-0dd5-40cb-8561-592dcd757e8d"
          },
          {
            "name": "FTE per Headcount",
            "displayFolder": "01 Workforce",
            "expression": "DIVIDE ( [Ending FTE], [Ending Headcount] )",
            "formatString": "0.00",
            "lineageTag": "71cb6dc9-84a2-4072-8602-8ac7755e3264"
          },
          {
            "name": "Headcount YoY Change",
            "displayFolder": "01 Workforce",
            "expression": [
              "VAR M = EDATE ( MAX ( 'Dim Month'[month] ), -12 )",
              "VAR Prior = CALCULATE ( [Ending Headcount], REMOVEFILTERS ( 'Dim Month' ), 'Dim Month'[month] = M )",
              "RETURN IF ( NOT ISBLANK ( Prior ), [Ending Headcount] - Prior )"
            ],
            "formatString": "#,0",
            "lineageTag": "de577408-9a26-4dca-b7df-b696de4623e7"
          },
          {
            "name": "Planned Headcount",
            "displayFolder": "02 Planning",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), CALCULATE ( SUM ( 'Fact Planning'[planned_headcount] ), KEEPFILTERS ( 'Dim Month'[month] = MAX ( 'Dim Month'[month] ) ) ) )",
            "formatString": "#,0",
            "lineageTag": "864deb0f-713e-428b-a541-78e227cdee2d"
          },
          {
            "name": "Planning Actual Headcount",
            "displayFolder": "02 Planning",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), CALCULATE ( SUM ( 'Fact Planning'[actual_headcount] ), KEEPFILTERS ( 'Dim Month'[month] = MAX ( 'Dim Month'[month] ) ) ) )",
            "formatString": "#,0",
            "lineageTag": "e7a732a0-b943-42e8-ad68-b85749cdc75d"
          },
          {
            "name": "Headcount Gap",
            "displayFolder": "02 Planning",
            "expression": "IF ( NOT ISBLANK ( [Planned Headcount] ) && NOT ISBLANK ( [Planning Actual Headcount] ), [Planning Actual Headcount] - [Planned Headcount] )",
            "formatString": "#,0",
            "lineageTag": "b1e8850c-93e1-4d7f-85e2-9bfd5dba923d"
          },
          {
            "name": "Headcount Attainment %",
            "displayFolder": "02 Planning",
            "expression": "DIVIDE ( [Planning Actual Headcount], [Planned Headcount] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "03b60e0e-703d-4e31-a0d2-f53fcdbae9e3"
          },
          {
            "name": "Budgeted FTE",
            "displayFolder": "02 Planning",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), CALCULATE ( SUM ( 'Fact Planning'[budgeted_fte] ), KEEPFILTERS ( 'Dim Month'[month] = MAX ( 'Dim Month'[month] ) ) ) )",
            "formatString": "#,0.0",
            "lineageTag": "9127624a-3637-4fd6-a7d8-e25610080e3e"
          },
          {
            "name": "Planning Actual FTE",
            "displayFolder": "02 Planning",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), CALCULATE ( SUM ( 'Fact Planning'[actual_fte] ), KEEPFILTERS ( 'Dim Month'[month] = MAX ( 'Dim Month'[month] ) ) ) )",
            "formatString": "#,0.0",
            "lineageTag": "88b5f89b-b4ef-4be0-ac27-7139488f845b"
          },
          {
            "name": "FTE Gap",
            "displayFolder": "02 Planning",
            "expression": "IF ( NOT ISBLANK ( [Budgeted FTE] ) && NOT ISBLANK ( [Planning Actual FTE] ), [Planning Actual FTE] - [Budgeted FTE] )",
            "formatString": "#,0.0",
            "lineageTag": "3ef944a1-ba8b-43b5-b0aa-611ef803cdb6"
          },
          {
            "name": "Hires",
            "displayFolder": "03 Attrition",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), SUM ( 'Fact Attrition'[hires] ) )",
            "formatString": "#,0",
            "lineageTag": "38573a14-2c49-4d52-b9bd-f4132df5e553"
          },
          {
            "name": "Terminations",
            "displayFolder": "03 Attrition",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), SUM ( 'Fact Attrition'[terminations] ) )",
            "formatString": "#,0",
            "lineageTag": "799df74e-7a3a-4447-bc01-53a76c15b832"
          },
          {
            "name": "Voluntary Terminations",
            "displayFolder": "03 Attrition",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), SUM ( 'Fact Attrition'[voluntary_terminations] ) )",
            "formatString": "#,0",
            "lineageTag": "a3f96420-189e-49f2-a509-8ce02e5c9d56"
          },
          {
            "name": "Involuntary Terminations",
            "displayFolder": "03 Attrition",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), SUM ( 'Fact Attrition'[involuntary_terminations] ) )",
            "formatString": "#,0",
            "lineageTag": "845f992f-a733-479f-86db-d10522f4025a"
          },
          {
            "name": "Net Hires",
            "description": "Recorded hires less exits; not equivalent to snapshot headcount change.",
            "displayFolder": "03 Attrition",
            "expression": "IF ( NOT ISBLANK ( [Hires] ), [Hires] - [Terminations] )",
            "formatString": "#,0",
            "lineageTag": "532c70a3-14a2-4e24-b5b5-fb5197fdb6c1"
          },
          {
            "name": "Monthly Average Headcount",
            "displayFolder": "03 Attrition",
            "expression": [
              "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), IF ( HASONEVALUE ( 'Dim Month'[month] ) &&",
              "    COUNTROWS ( FILTER ( 'Fact Attrition', ISBLANK ( 'Fact Attrition'[average_headcount] ) ) ) = 0,",
              "    SUM ( 'Fact Attrition'[average_headcount] ) ) )"
            ],
            "formatString": "#,0.0",
            "lineageTag": "cdd2f1a6-5834-4a64-a3d4-7e2d3a1bf168"
          },
          {
            "name": "Monthly Attrition %",
            "description": "One month only. Source reconciliation may be provisional.",
            "displayFolder": "03 Attrition",
            "expression": "DIVIDE ( [Terminations], [Monthly Average Headcount] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "366fb6c8-9fbb-4a57-9232-a795c867db04"
          },
          {
            "name": "Monthly Voluntary Attrition %",
            "description": "One month only. Source reconciliation may be provisional.",
            "displayFolder": "03 Attrition",
            "expression": "DIVIDE ( [Voluntary Terminations], [Monthly Average Headcount] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "2b9e62db-1dc8-42cf-aef2-ae7357e97781"
          },
          {
            "name": "Monthly Involuntary Attrition %",
            "description": "One month only. Source reconciliation may be provisional.",
            "displayFolder": "03 Attrition",
            "expression": "DIVIDE ( [Involuntary Terminations], [Monthly Average Headcount] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "410a74bf-9693-4cb2-ac22-0e8287032a50"
          },
          {
            "name": "Attrition Quality Status",
            "description": "Company-level source warning propagated into department rates.",
            "displayFolder": "03 Attrition",
            "expression": [
              "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), SWITCH ( TRUE (),",
              "    COUNTROWS ( 'Fact Attrition' ) = 0, BLANK (),",
              "    COUNTROWS ( FILTER ( 'Fact Attrition', 'Fact Attrition'[rate_quality_status] = \"NO_PRIOR_SNAPSHOT\" ) ) > 0, \"Missing prior snapshot\",",
              "    COUNTROWS ( FILTER ( 'Fact Attrition', 'Fact Attrition'[rate_quality_status] = \"PROVISIONAL_SOURCE_MISMATCH\" ) ) > 0, \"Provisional - source mismatch\",",
              "    \"Reference matched\" ) )"
            ],
            "lineageTag": "e2bbdedb-25d0-4264-b8ed-abb26b617cb0"
          },
          {
            "name": "Ending Open Requisitions",
            "displayFolder": "04 Recruitment",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), CALCULATE ( SUM ( 'Fact Recruitment'[open_requisitions] ), KEEPFILTERS ( 'Dim Month'[month] = MAX ( 'Dim Month'[month] ) ) ) )",
            "formatString": "#,0",
            "lineageTag": "e598b1ff-9b0d-4d57-bab9-cce408a5d148"
          },
          {
            "name": "Filled Requisitions",
            "displayFolder": "04 Recruitment",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), SUM ( 'Fact Recruitment'[filled_requisitions] ) )",
            "formatString": "#,0",
            "lineageTag": "e16c98b9-1ef6-4acf-90f9-53bacc07ffee"
          },
          {
            "name": "Cancelled Requisitions",
            "displayFolder": "04 Recruitment",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), SUM ( 'Fact Recruitment'[cancelled_requisitions] ) )",
            "formatString": "#,0",
            "lineageTag": "024cdb48-0d1e-4808-acf1-3c24b52bddad"
          },
          {
            "name": "Weighted Days to Fill",
            "description": "Weighted by fills with a known duration.",
            "displayFolder": "04 Recruitment",
            "expression": [
              "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), VAR Known = FILTER ( 'Fact Recruitment', 'Fact Recruitment'[filled_requisitions] > 0 && NOT ISBLANK ( 'Fact Recruitment'[avg_days_to_fill] ) )",
              "RETURN DIVIDE ( SUMX ( Known, 'Fact Recruitment'[weighted_days_to_fill_numerator] ), SUMX ( Known, 'Fact Recruitment'[filled_requisitions] ) ) )"
            ],
            "formatString": "#,0.0",
            "lineageTag": "6f083b9c-c3fa-4e77-9e44-353551829bc0"
          },
          {
            "name": "Fill Share of Closed Requisitions",
            "description": "Share of observed closed requisitions; not a funnel conversion rate.",
            "displayFolder": "04 Recruitment",
            "expression": "DIVIDE ( [Filled Requisitions], [Filled Requisitions] + [Cancelled Requisitions] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "bcfaedec-b6b0-46f9-8e3e-ac5e001602ca"
          },
          {
            "name": "Prior Month Open Requisitions",
            "displayFolder": "04 Recruitment",
            "expression": [
              "VAR M = EDATE ( MAX ( 'Dim Month'[month] ), -1 )",
              "RETURN CALCULATE ( [Ending Open Requisitions], REMOVEFILTERS ( 'Dim Month' ), 'Dim Month'[month] = M )"
            ],
            "formatString": "#,0",
            "lineageTag": "e96bfde5-779d-461e-964d-214efc95dfbd"
          },
          {
            "name": "Observed Employees",
            "description": "Historical profile population at observation endpoint; not monthly headcount.",
            "displayFolder": "05 Retention",
            "expression": "SUM ( 'Fact Retention'[employee_count] )",
            "formatString": "#,0",
            "lineageTag": "e43bf2b1-f302-4d17-8fb9-081a6a995025"
          },
          {
            "name": "Exited Employees",
            "displayFolder": "05 Retention",
            "expression": "CALCULATE ( [Observed Employees], KEEPFILTERS ( 'Fact Retention'[exited] = TRUE () ) )",
            "formatString": "#,0",
            "lineageTag": "f090d329-deb4-4908-91fc-327c8ea140cf"
          },
          {
            "name": "Active Employees",
            "displayFolder": "05 Retention",
            "expression": "CALCULATE ( [Observed Employees], KEEPFILTERS ( 'Fact Retention'[exited] = FALSE () ) )",
            "formatString": "#,0",
            "lineageTag": "1e3ad1a6-baa5-4259-9c3d-e005462bf1d2"
          },
          {
            "name": "Average Engagement Score",
            "description": "Latest observed/pre-exit survey; excludes missing values.",
            "displayFolder": "05 Retention",
            "expression": "DIVIDE ( SUM ( 'Fact Retention'[engagement_sum] ), SUM ( 'Fact Retention'[engagement_count] ) )",
            "formatString": "0.00",
            "lineageTag": "f700feea-3235-4426-b993-e1af65c2b894"
          },
          {
            "name": "Average Performance Rating",
            "displayFolder": "05 Retention",
            "expression": "DIVIDE ( SUM ( 'Fact Retention'[performance_sum] ), SUM ( 'Fact Retention'[performance_count] ) )",
            "formatString": "0.00",
            "lineageTag": "10f1defb-4dc7-47f5-83c9-44b147460e92"
          },
          {
            "name": "Average Prior 365d Absence Days",
            "displayFolder": "05 Retention",
            "expression": "DIVIDE ( SUM ( 'Fact Retention'[absence_days_sum] ), [Observed Employees] )",
            "formatString": "#,0.0",
            "lineageTag": "55c3fb87-5d07-42d7-aa7d-b936d0880102"
          },
          {
            "name": "Headcount YoY %",
            "displayFolder": "06 Time Intelligence",
            "expression": [
              "VAR M = EDATE ( MAX ( 'Dim Month'[month] ), -12 )",
              "VAR Prior = CALCULATE ( [Ending Headcount], REMOVEFILTERS ( 'Dim Month' ), 'Dim Month'[month] = M )",
              "RETURN DIVIDE ( [Headcount YoY Change], Prior )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "49d0fdbc-1590-4381-8ec2-86fb49580772"
          },
          {
            "name": "YTD Hires",
            "displayFolder": "06 Time Intelligence",
            "expression": [
              "VAR M = MAX ( 'Dim Month'[month] )",
              "RETURN CALCULATE ( [Hires], FILTER ( ALL ( 'Dim Month' ), 'Dim Month'[year] = YEAR ( M ) && 'Dim Month'[month] <= M ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "77bc4910-b6f7-4a9b-a34b-ccc32091c6fc"
          },
          {
            "name": "YTD Terminations",
            "displayFolder": "06 Time Intelligence",
            "expression": [
              "VAR M = MAX ( 'Dim Month'[month] )",
              "RETURN CALCULATE ( [Terminations], FILTER ( ALL ( 'Dim Month' ), 'Dim Month'[year] = YEAR ( M ) && 'Dim Month'[month] <= M ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "f57d4248-6a86-4ffe-a812-a16fbfee66cc"
          },
          {
            "name": "Period Attrition %",
            "description": "Selected contiguous period exits divided by mean monthly workforce; blank if any month lacks valid denominator.",
            "displayFolder": "06 Time Intelligence",
            "expression": [
              "IF ( ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), VAR Months = VALUES ( 'Dim Month'[month] )",
              "VAR ValidMonths = FILTER ( Months, NOT ISBLANK ( CALCULATE ( [Monthly Average Headcount] ) ) && CALCULATE ( [Monthly Average Headcount] ) > 0 )",
              "VAR N = COUNTROWS ( Months )",
              "VAR Span = DATEDIFF ( MIN ( 'Dim Month'[month] ), MAX ( 'Dim Month'[month] ), MONTH ) + 1",
              "RETURN IF ( N > 0 && N = Span && COUNTROWS ( ValidMonths ) = N,",
              "    DIVIDE ( [Terminations], AVERAGEX ( ValidMonths, CALCULATE ( [Monthly Average Headcount] ) ) ) ) )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "1c1bae7b-405a-4f38-93d9-ab7db761b24a"
          },
          {
            "name": "Rolling 12M Attrition %",
            "description": "Requires twelve consecutive valid monthly denominators.",
            "displayFolder": "06 Time Intelligence",
            "expression": [
              "VAR M = MAX ( 'Dim Month'[month] )",
              "VAR WindowMonths = FILTER ( ALL ( 'Dim Month' ), 'Dim Month'[month] > EDATE ( M, -12 ) && 'Dim Month'[month] <= M )",
              "RETURN IF ( COUNTROWS ( WindowMonths ) = 12, CALCULATE ( [Period Attrition %], WindowMonths ) )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "9f491427-f8a8-4805-bc5e-4b3a3847c15e"
          },
          {
            "name": "Rolling 12M Terminations",
            "displayFolder": "06 Time Intelligence",
            "expression": [
              "VAR M = MAX ( 'Dim Month'[month] )",
              "VAR WindowMonths = FILTER ( ALL ( 'Dim Month' ), 'Dim Month'[month] > EDATE ( M, -12 ) && 'Dim Month'[month] <= M )",
              "RETURN IF ( COUNTROWS ( WindowMonths ) = 12, CALCULATE ( [Terminations], WindowMonths ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "2230c663-8835-410d-9891-9e8126a3e6e8"
          },
          {
            "name": "YTD Filled Requisitions",
            "displayFolder": "06 Time Intelligence",
            "expression": [
              "VAR M = MAX ( 'Dim Month'[month] )",
              "RETURN CALCULATE ( [Filled Requisitions], FILTER ( ALL ( 'Dim Month' ), 'Dim Month'[year] = YEAR ( M ) && 'Dim Month'[month] <= M ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "cfffcb03-195a-4bc3-8272-83d44a67f4ea"
          },
          {
            "name": "Snapshot Reconciliation Difference",
            "description": "Company-wide; blank when department, location or level is filtered.",
            "displayFolder": "07 Data Quality",
            "expression": [
              "IF ( ISCROSSFILTERED ( 'Dim Department' ) || ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), VAR LastMonth = MAX ( 'Dim Month'[month] )",
              "RETURN CALCULATE ( SUM ( 'Fact Reconciliation'[headcount_difference] ), KEEPFILTERS ( 'Dim Month'[month] = LastMonth ) ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "4e9197bf-ca65-472d-9920-96b7577ae58f"
          },
          {
            "name": "Reconciliation Review Months",
            "displayFolder": "07 Data Quality",
            "expression": "IF ( ISCROSSFILTERED ( 'Dim Department' ) || ISCROSSFILTERED ( 'Dim Location' ) || ISCROSSFILTERED ( 'Dim Level' ), BLANK (), COALESCE ( CALCULATE ( DISTINCTCOUNT ( 'Fact Reconciliation'[month] ), KEEPFILTERS ( 'Fact Reconciliation'[reconciliation_status] = \"REVIEW\" ) ), 0 ) )",
            "formatString": "#,0",
            "lineageTag": "f522b8d1-aaf3-471c-aa40-ad8333af8185"
          },
          {
            "name": "Latest Pipeline Run ID",
            "displayFolder": "07 Data Quality",
            "expression": "MAXX ( ALL ( 'Pipeline Runs' ), 'Pipeline Runs'[pipeline_run_id] )",
            "formatString": "#,0",
            "lineageTag": "9e89c4cd-ddc0-4221-970d-e671ac4b0cfb"
          },
          {
            "name": "Latest Pipeline Status",
            "displayFolder": "07 Data Quality",
            "expression": [
              "VAR R = [Latest Pipeline Run ID]",
              "RETURN CALCULATE ( SELECTEDVALUE ( 'Pipeline Runs'[status] ), REMOVEFILTERS ( 'Pipeline Runs' ), 'Pipeline Runs'[pipeline_run_id] = R )"
            ],
            "lineageTag": "73e0303e-c68a-4d90-9385-ad73832ca22b"
          },
          {
            "name": "Latest Quality PASS",
            "description": "Blank when the latest run has no completed quality checks; zero only after checks exist.",
            "displayFolder": "07 Data Quality",
            "expression": [
              "VAR R = [Latest Pipeline Run ID]",
              "VAR CheckCount = CALCULATE ( COUNTROWS ( 'Quality Results' ), REMOVEFILTERS ( 'Pipeline Runs' ), REMOVEFILTERS ( 'Quality Results' ), 'Quality Results'[pipeline_run_id] = R )",
              "RETURN IF ( NOT ISBLANK ( R ) && CheckCount > 0, COALESCE ( CALCULATE ( COUNTROWS ( 'Quality Results' ), REMOVEFILTERS ( 'Pipeline Runs' ), REMOVEFILTERS ( 'Quality Results' ), 'Quality Results'[pipeline_run_id] = R, 'Quality Results'[status] = \"PASS\" ), 0 ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "34fe072e-dc81-4b68-8890-f5317b49d5a1"
          },
          {
            "name": "Latest Quality REVIEW",
            "description": "Blank when the latest run has no completed quality checks; zero only after checks exist.",
            "displayFolder": "07 Data Quality",
            "expression": [
              "VAR R = [Latest Pipeline Run ID]",
              "VAR CheckCount = CALCULATE ( COUNTROWS ( 'Quality Results' ), REMOVEFILTERS ( 'Pipeline Runs' ), REMOVEFILTERS ( 'Quality Results' ), 'Quality Results'[pipeline_run_id] = R )",
              "RETURN IF ( NOT ISBLANK ( R ) && CheckCount > 0, COALESCE ( CALCULATE ( COUNTROWS ( 'Quality Results' ), REMOVEFILTERS ( 'Pipeline Runs' ), REMOVEFILTERS ( 'Quality Results' ), 'Quality Results'[pipeline_run_id] = R, 'Quality Results'[status] = \"REVIEW\" ), 0 ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "a514e9a4-3622-44bb-b6bb-6c9c352c355e"
          },
          {
            "name": "Latest Quality FAIL",
            "description": "Blank when the latest run has no completed quality checks; zero only after checks exist.",
            "displayFolder": "07 Data Quality",
            "expression": [
              "VAR R = [Latest Pipeline Run ID]",
              "VAR CheckCount = CALCULATE ( COUNTROWS ( 'Quality Results' ), REMOVEFILTERS ( 'Pipeline Runs' ), REMOVEFILTERS ( 'Quality Results' ), 'Quality Results'[pipeline_run_id] = R )",
              "RETURN IF ( NOT ISBLANK ( R ) && CheckCount > 0, COALESCE ( CALCULATE ( COUNTROWS ( 'Quality Results' ), REMOVEFILTERS ( 'Pipeline Runs' ), REMOVEFILTERS ( 'Quality Results' ), 'Quality Results'[pipeline_run_id] = R, 'Quality Results'[status] = \"FAIL\" ), 0 ) )"
            ],
            "formatString": "#,0",
            "lineageTag": "ff0716b2-7c96-4f0d-81d2-b7d2d6d278e8"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #table(type table [Placeholder = Int64.Type], {{1}})",
                "in",
                "    Source"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
