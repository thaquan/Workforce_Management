                "    Typed = Table.TransformColumnTypes(Source, {{\"pipeline_run_id\", Int64.Type}, {\"status\", type text}, {\"run_mode\", type text}, {\"stage\", type text}, {\"started_at\", type datetime}, {\"finished_at\", type datetime}})",
